flowchart TD
    %% Apex Global Technologies - Complete Enterprise Architecture (Phase 3.7)
    
    subgraph External_Plane ["External Traffic & Users"]
        INTERNET["Public Internet / Untrusted Traffic"]
        CORP_REMOTE["Corporate Remote Users / GlobalProtect VPN"]
    end

    subgraph Perimeter_Security ["Perimeter Network Security Layer (PAN-OS 11.1 Nebula)"]
        PANORAMA["Panorama Management Server<br/>pan-mgmt-01 (M-600 Virtual)"]
        
        subgraph Edge_HA ["Internet Perimeter Firewall HA Pair (PA-5450)"]
            FW_EDGE_1["fw-edge-01-primary (Active)"]
            FW_EDGE_2["fw-edge-02-secondary (Passive)"]
            FW_EDGE_1 <-->|HA1 Control / HA2 Data Sync| FW_EDGE_2
        end

        PANORAMA -.->|Device Group: DG-Internet-Perimeter| FW_EDGE_1
        PANORAMA -.->|Device Group: DG-Internet-Perimeter| FW_EDGE_2
    end

    INTERNET -->|Untrust Ingress| FW_EDGE_1
    CORP_REMOTE -->|SSL VPN Ingress| FW_EDGE_1

    subgraph Perimeter_Zones ["Perimeter & Corporate Zones"]
        ZONE_DMZ["Zone: Trust-DMZ<br/>Subnet 10.100.4.0/24"]
        ZONE_CORP["Zone: Corp-Users<br/>Subnet 10.10.0.0/16"]
        ZONE_TRANSIT["Zone: Transit-Internal<br/>Subnet 10.255.0.0/30 Interconnect"]
    end

    FW_EDGE_1 -->|App-ID Inbound DNAT| ZONE_DMZ
    FW_EDGE_1 -->|User-ID Inspection| ZONE_CORP
    FW_EDGE_1 -->|Inter-Firewall Route| ZONE_TRANSIT

    subgraph Internal_Security ["Internal Segmentation Layer (PAN-OS 11.1 Nebula)"]
        subgraph Core_HA ["Internal Segmentation Firewall HA Pair (PA-3440)"]
            FW_INT_1["fw-internal-01-primary (Active)"]
            FW_INT_2["fw-internal-02-secondary (Passive)"]
            FW_INT_1 <-->|HA1 Control / HA2 Data Sync| FW_INT_2
        end

        PANORAMA -.->|Device Group: DG-Internal-Segmentation| FW_INT_1
        PANORAMA -.->|Device Group: DG-Internal-Segmentation| FW_INT_2
    end

    ZONE_TRANSIT -->|High-Speed Interconnect| FW_INT_1

    subgraph Internal_Zones ["Internal Security Zones"]
        ZONE_PROD["Zone: Prod-App-Workloads<br/>Subnet 10.100.10.0/23"]
        ZONE_DEV["Zone: Dev-App-Workloads<br/>Subnet 10.200.10.0/23"]
        ZONE_DB["Zone: Database-Backend<br/>Subnet 10.100.20.0/24"]
        ZONE_PCI["Zone: PCI-Cardholder-Data<br/>Subnet 10.100.30.0/24"]
        ZONE_VAULT["Zone: Restricted-Data-Vault<br/>Subnet 10.100.40.0/24"]
    end

    FW_INT_1 -->|Enforces Zero-Trust Policy| ZONE_PROD
    FW_INT_1 -->|Dev/Sandbox Policy| ZONE_DEV
    FW_INT_1 -->|Strict SQL Inspection| ZONE_DB
