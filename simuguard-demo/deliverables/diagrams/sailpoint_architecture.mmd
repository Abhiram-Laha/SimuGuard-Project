        SRC_AWS_PROD["sp-src-aws-prod<br/>AWS Production Account"]
        SRC_AWS_DEV["sp-src-aws-dev<br/>AWS Development Account"]
        SRC_AWS_SEC["sp-src-aws-secops<br/>AWS Security Account"]
        SRC_PAN["sp-src-firewall-mgmt<br/>Palo Alto Panorama Mgmt"]
        SRC_APPS["sp-src-enterprise-apps<br/>Enterprise Applications"]
        SRC_DB["sp-src-database-platform<br/>Database Platform"]
    end

    TENANT ==>|Connected Source Connector| Connected_Sources

