        AWS_PROD["AWS Account: 111122223333"]
        AWS_DEV["AWS Account: 222233334444"]
        AWS_SEC["AWS Account: 333344445555"]
        PAN_MGMT["Panorama: pan-mgmt-01"]
        S3_VAULT["S3 Bucket: s3-enterprise-cui-vault"]
